      "activation": "pv12",
      "surfaces": [
        "era-identity"
      ],
      "compatibility": "decode-break",
      "basis": "source-verified",
      "summary": "Dijkstra follows Conway (protocol versions 9-11) as the eighth hard-fork-combinator era. Plutus gates PlutusV4 on the same version.",
      "affects": "Anything with a closed list of eras or era tags: chain followers, block/tx decoders, era-indexed JSON, explorers, and Haskell code matching exhaustively on eras.",
      "citations": [
