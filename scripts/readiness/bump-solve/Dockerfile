FROM haskell@sha256:3abe1175a5466fe760ed90937b32b42be340281b6707dace6d5addea2148d05e
RUN apt-get update && apt-get install -t bullseye -y --no-install-recommends pkg-config libsodium-dev libsecp256k1-dev libpq-dev && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/supranational/blst.git /tmp/blst && cd /tmp/blst && git checkout --detach 52cc60d78591a56abb2f3d0bd1cdafc6ba242997 && ./build.sh && ./build.sh -shared && install -m 644 libblst.a libblst.so /usr/local/lib/ && install -m 644 bindings/blst.h bindings/blst_aux.h /usr/local/include/ && mkdir -p /usr/local/lib/pkgconfig && printf '%s\n' 'prefix=/usr/local' 'exec_prefix=${prefix}' 'libdir=${exec_prefix}/lib' 'includedir=${prefix}/include' 'Name: libblst' 'Description: BLS12-381 signature library' 'Version: 0.3.13' 'Cflags: -I${includedir}' 'Libs: -L${libdir} -lblst' > /usr/local/lib/pkgconfig/libblst.pc && ldconfig && rm -rf /tmp/blst
RUN git clone https://github.com/supranational/blst.git /tmp/blst && cd /tmp/blst && git checkout --detach 8c7db7fe8d2ce6e76dc398ebd4d475c0ec564355 && ./build.sh && ./build.sh -shared && install -m 644 libblst.a libblst.so /usr/local/lib/ && install -m 644 bindings/blst.h bindings/blst_aux.h /usr/local/include/ && sed -i 's/^Version: .*/Version: 0.3.14/' /usr/local/lib/pkgconfig/libblst.pc && ldconfig && rm -rf /tmp/blst
RUN git clone https://github.com/axboe/liburing.git /tmp/uring && cd /tmp/uring && git checkout --detach 5dd20d52f442feae7023af5772429910d3aa5307 && ./configure --prefix=/usr/local && make -C src -j4 && make -C src install && make liburing.pc && install -m 644 liburing.pc /usr/local/lib/pkgconfig/ && ldconfig && rm -rf /tmp/uring
